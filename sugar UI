--[[
	SugarUI
	--------
	Misma interfaz que PanelUI (tema oscuro, acentos rojos, badge de admin,
	pill de servidor, sidebar con buscador/secciones/perfil, tarjetas de
	estadísticas y accesos rápidos) — pero ahora con un NÚCLEO capaz de
	ejecutar CUALQUIER lógica externa conectada (bucles de combate Auto-M1,
	toggles de habilidades, sliders de configuración, dropdowns, keybinds...)
	sin congelar jamás la interfaz ni el hilo principal del juego.

	Qué cambió respecto a una librería "solo visual":

	1. INVOCACIÓN ASÍNCRONA SEGURA
	   Todo callback conectado por el usuario corre dentro de:
	       task.spawn(function() pcall(fn, ...) end)
	   Un `while true do ... end` dentro de un Toggle o Keybind vive en su
	   propio hilo y NUNCA bloquea el render de la UI. Si el callback lanza
	   un error, pcall lo atrapa y se reporta con warn(), sin romper nada.

	2. CALLBACKS CON VALOR POR DEFECTO
	   config.Callback or function() end — nunca se llama nil.

	3. CONTROLADORES DINÁMICOS
	   Cada componente interactivo devuelve un objeto con :Set(...) que
	   actualiza la UI y dispara la lógica, para poder controlar el panel
	   programáticamente desde tu propio script.

	4. FLAGS GLOBALES
	   config.Flag = "AutoM1" registra el controlador en SugarUI.Flags y su
	   valor "crudo" en SugarUI.FlagValues, accesibles desde cualquier lado.

	5. LIMPIEZA DE CONEXIONES
	   Cada Window guarda todas sus RBXScriptConnections en _connections y
	   las desconecta en :Destroy(), evitando fugas de memoria.

	6. HILOS RASTREADOS + :Stop()
	   Cada vez que un controlador (Toggle, Slider, Dropdown, Keybind,
	   Button, QuickAccess) dispara su Callback, se guarda el hilo devuelto
	   por task.spawn en controlador._thread. Cualquier script externo puede
	   llamar a controlador:Stop() para cortar de una un loop que haya
	   quedado corriendo (por ejemplo, si el comprador de la librería usa
	   una lógica de combate propia que no revisa el flag por sí sola).
	   Esto es genérico: no depende de qué juego ni de qué lógica sea.

	Uso básico:

		local SugarUI = require(script.SugarUI)

		local Window = SugarUI:CreateWindow({
			Title      = "Top 1 Col",
			Badge      = "ADMIN",
			ServerName = "Servidor en línea",
			ServerOn   = true,
		})

		local Principal = Window:CreateTab({ Name = "Principal", Icon = "P", Section = "GENERAL" })
		local Combate    = Window:CreateTab({ Name = "Combate",   Icon = "C", Section = "ACCIONES" })

		Principal:CreateStatRow()
		Principal:CreateStat({ Value = "24", Label = "jugadores en línea" })

		local AutoM1 = Combate:CreateToggle({
			Text = "Auto-M1",
			Flag = "AutoM1",
			Callback = function(state)
				while state and SugarUI.FlagValues["AutoM1"] do
					-- tu lógica de combate aquí (puede ser CUALQUIER cosa,
					-- de cualquier juego: no depende de SugarUI)
					task.wait(0.1)
				end
			end,
		})

		-- Disparar desde afuera:
		SugarUI.Flags["AutoM1"]:Set(true)

		-- Frenar el hilo del callback a la fuerza desde afuera, sin
		-- importar qué lógica tenga adentro:
		AutoM1:Stop()
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local SugarUI = {}
SugarUI.__index = SugarUI

-- ============================================================
-- 	PROPIEDADES DE LIBRERÍA
-- ============================================================
SugarUI.Version    = "1.2.0"
SugarUI.Windows    = {}
SugarUI.Flags      = {}   -- Flags[flagName] = controlador (con :Set, :Get, etc.)
SugarUI.FlagValues = {}   -- FlagValues[flagName] = valor actual "crudo"
SugarUI.Theme      = nil

local function getGuiParent()
	local ok, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)

	if ok and coreGui then
		local getHui = rawget(_G, "gethui")
		if typeof(getHui) == "function" then
			local success, hui = pcall(getHui)
			if success and hui then
				return hui
			end
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	local playerGui = player:WaitForChild("PlayerGui")
	return playerGui
end

