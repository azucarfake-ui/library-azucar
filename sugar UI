function SugarUI:CreateWindow(config)
	config = config or {}

	local ScreenGui = new("ScreenGui", {
		Name = config.Title or "SugarUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})

	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then
		pcall(protectGui, ScreenGui)
	end

	ScreenGui.Parent = getGuiParent()

	local Root = new("Frame", {
		Name = "Root",
		Size = config.Size or UDim2.new(0, 640, 0, 440),
		Position = config.Position or UDim2.new(0.5, -320, 0.5, -220),
		BackgroundColor3 = config.BackgroundColor or Theme.Background,
		BackgroundTransparency = config.BackgroundTransparency or Theme.BackgroundTransparency,
		ClipsDescendants = true,
		Parent = ScreenGui,
	}, { corner(22), stroke(Theme.Stroke, 1) })

	local MARGIN = 12
	local GAP = 10
	local TOPBAR_H = 54
	local SIDEBAR_W = 190
	local ROW_Y = MARGIN + TOPBAR_H + GAP

	-- ---------------- Barra superior ----------------
	local TopBar = new("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, -MARGIN * 2, 0, TOPBAR_H),
		Position = UDim2.new(0, MARGIN, 0, MARGIN),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	new("TextLabel", {
		Text = "1",
		Font = Theme.FontBold,
		TextSize = 16,
		TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 32, 0, 32),
		Position = UDim2.new(0, 16, 0.5, -16),
		Parent = TopBar,
	}, { corner(16), accentGradient() })

	new("TextLabel", {
		Text = config.Title or "Panel",
		Font = Theme.FontBold,
		TextSize = 17,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 160, 0, 20),
		Position = UDim2.new(0, 60, 0.5, -10),
		Parent = TopBar,
	})

	if config.Badge then
		new("TextLabel", {
			Text = config.Badge,
			Font = Theme.FontBold,
			TextSize = 11,
			TextColor3 = Theme.Text,
			BackgroundColor3 = Theme.Accent,
			Size = UDim2.new(0, 54, 0, 22),
			Position = UDim2.new(0, 220, 0.5, -11),
			Parent = TopBar,
		}, { corner(11), accentGradient() })
	end

	local ServerPill = new("Frame", {
		Size = UDim2.new(0, 190, 0, 32),
		Position = UDim2.new(0, 300, 0.5, -16),
		BackgroundColor3 = Theme.PanelAlt,
		Parent = TopBar,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	local ServerDot = new("Frame", {
		Size = UDim2.new(0, 8, 0, 8),
		Position = UDim2.new(0, 14, 0.5, -4),
		BackgroundColor3 = config.ServerOn ~= false and Theme.Online or Theme.TextFaint,
		Parent = ServerPill,
	}, { corner(4) })

	new("TextLabel", {
		Text = config.ServerName or "Servidor en línea",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -32, 1, 0),
		Position = UDim2.new(0, 28, 0, 0),
		Parent = ServerPill,
	})

	local MinimizeBtn = new("TextButton", {
		Text = "—",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 32, 0, 32),
		Position = UDim2.new(1, -80, 0.5, -16),
		Parent = TopBar,
	}, { corner(16), accentGradient() })

	local CloseBtn = new("TextButton", {
		Text = "✕",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 32, 0, 32),
		Position = UDim2.new(1, -40, 0.5, -16),
		Parent = TopBar,
	}, { corner(16), accentGradient() })

	hoverTint(MinimizeBtn, Theme.Accent, Theme.AccentDim)
	hoverTint(CloseBtn, Theme.Accent, Theme.AccentDim)
	pressFeedback(MinimizeBtn)
	pressFeedback(CloseBtn)

	-- ---------------- Sidebar ----------------
	local Sidebar = new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, SIDEBAR_W, 1, -(ROW_Y + MARGIN)),
		Position = UDim2.new(0, MARGIN, 0, ROW_Y),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	new("TextBox", {
		PlaceholderText = "Buscar pestaña...",
		Text = "",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		BackgroundColor3 = Theme.PanelAlt,
		Size = UDim2.new(1, -32, 0, 36),
		Position = UDim2.new(0, 16, 0, 16),
		Parent = Sidebar,
	}, { corner(18), pad(0, 0, 0, 0, 12), stroke(Theme.Stroke, 1) })

	local SidebarList = new("ScrollingFrame", {
		Name = "SidebarList",
		Size = UDim2.new(1, 0, 1, -142),
		Position = UDim2.new(0, 0, 0, 66),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Sidebar,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 4, 16, 16, 16),
	})

	-- ---------------- Tarjeta de perfil ----------------
	new("Frame", {
		Size = UDim2.new(1, -32, 0, 1),
		Position = UDim2.new(0, 16, 1, -78),
		BackgroundColor3 = Theme.Stroke,
		Parent = Sidebar,
	})

	local ProfileRow = new("Frame", {
		Name = "ProfileRow",
		Size = UDim2.new(1, -32, 0, 46),
		Position = UDim2.new(0, 16, 1, -60),
		BackgroundTransparency = 1,
		Parent = Sidebar,
	})

	-- ---------------- Área de contenido ----------------
	local Content = new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -(MARGIN + SIDEBAR_W + GAP + MARGIN), 1, -(ROW_Y + MARGIN)),
		Position = UDim2.new(0, MARGIN + SIDEBAR_W + GAP, 0, ROW_Y),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	local ContentScroll = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Content,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 20), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 20, 20, 20, 20),
	})

	-- ---------------- Burbuja flotante ----------------
	local Bubble = new("TextButton", {
		Name = "Bubble",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(0, 50, 0, 50),
		Position = UDim2.new(1, -80, 1, -80),
		BackgroundColor3 = Theme.Accent,
		Visible = false,
		Parent = ScreenGui,
	}, { corner(25), stroke(Theme.Stroke, 1), accentGradient(135) })

	new("TextLabel", {
		Text = "🍬",
		Font = Theme.FontBold,
		TextSize = 22,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = Bubble,
	})

	hoverTint(Bubble, Theme.Accent, Theme.AccentDim)

	-- ============================================================
	local Window = setmetatable({
		ScreenGui = ScreenGui,
		Root = Root,
		Sidebar = Sidebar,
		SidebarList = SidebarList,
		ProfileRow = ProfileRow,
		Content = Content,
		ContentScroll = ContentScroll,
		Bubble = Bubble,
		_tabs = {},
		_sections = {},
		_connections = {},
	}, SugarUI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	track(Bubble.MouseButton1Click:Connect(function()
		Window:Show()
	end))

	-- Arrastrar la burbuja
	do
		local dragging = false
		local dragStart, startPos
		track(Bubble.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Bubble.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Bubble.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
	end

	track(MinimizeBtn.MouseButton1Click:Connect(function()
		Window:Hide()
		safeCall(Window.OnMinimize)
	end))
	track(CloseBtn.MouseButton1Click:Connect(function()
		Window:Hide()
		safeCall(Window.OnClose)
	end))

	-- ---------------- Arrastrar la ventana ----------------
	do
		local dragging = false
		local dragStart, startPos

		track(TopBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Root.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end))

		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Root.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
	end

	-- ---------------- Atajo de teclado (por defecto K) ----------------
	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(SugarUI.Windows, Window)
	return Window
end

-- ------------------------------------------------------------
-- 	Métodos de ventana
-- ------------------------------------------------------------
function SugarUI:Show()
	self.Root.Visible = true
	if self.Bubble then self.Bubble.Visible = false end
end

function SugarUI:Hide()
	self.Root.Visible = false
	if self.Bubble then self.Bubble.Visible = true end
end

function SugarUI:Toggle()
	if self.Root.Visible then self:Hide() else self:Show() end
end

-- Desconecta TODAS las conexiones guardadas (arrastre, atajos, clicks de
-- tabs/elementos, etc.) y destruye la instancia. Evita fugas de memoria.
function SugarUI:Destroy()
	if self._connections then
		for _, conn in ipairs(self._connections) do
			pcall(function() conn:Disconnect() end)
		end
	end
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
	for i, w in ipairs(SugarUI.Windows) do
		if w == self then
			table.remove(SugarUI.Windows, i)
			break
		end
	end
end

-- ============================================================
-- 	SECCIONES DEL SIDEBAR (GENERAL / ACCIONES / etc.)
-- ============================================================
function SugarUI:_getSection(name)
	if self._sections[name] then
		return self._sections[name]
	end

	new("TextLabel", {
		Text = name,
		Font = Theme.FontSemibold,
		TextSize = 11,
		TextColor3 = Theme.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = #self._sections * 1000,
		Parent = self.SidebarList,
	})

	self._sections[name] = true
	return true
end

function SugarUI:CreateDivider()
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		LayoutOrder = 900 + (#self._sections * 1000),
		Parent = self.SidebarList,
	})
end

