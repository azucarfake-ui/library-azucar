			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 40),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self._rowCount += 1

	local StatRow = setmetatable({ Row = Row, _count = 0 }, PanelUI)
	return StatRow
