		Parent = self.Page,
	}, { corner(16), stroke(Theme.Stroke, 1), pad(0, 0, 16, 0, 16) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Opciones",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, 0, 1, 0),
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = tostring(selected or "—"),
		Font = Theme.FontSemibold,
		TextSize = 14,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, -20, 1, 0),
		Parent = Row,
	})

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local ListFrame = new("Frame", {
		Size = UDim2.new(1, 0, 0, math.min(#options, 5) * 32 + 8),
		Position = UDim2.new(0, 0, 1, 6),
		BackgroundColor3 = Theme.PanelAlt,
		Visible = false,
		ZIndex = 5,
		Parent = Row,
	}, {
		corner(12), stroke(Theme.Stroke, 1), pad(4),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Dropdown = setmetatable({ Value = selected, Callback = callback, Options = options, _thread = nil }, SugarUI)

	-- :Set(opción) cambia la selección Y dispara el callback — útil para
	-- sincronizar el dropdown con un estado externo (ej: modo de combate).
	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = tostring(option)
		SugarUI.FlagValues[config.Flag] = option
		self._thread = safeCall(self.Callback, option)
	end

	function Dropdown:Stop()
		stopThread(self)
	end

	for _, optionValue in ipairs(options) do
		local OptionBtn = new("TextButton", {
			Text = tostring(optionValue),
			Font = Theme.Font,
			TextSize = 13,
			TextColor3 = Theme.Text,
			BackgroundColor3 = Theme.Panel,
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, 28),
			Parent = ListFrame,
		}, { corner(8) })
		hoverTint(OptionBtn, Theme.Panel, Theme.Sidebar)

		table.insert(self.Window._connections, OptionBtn.MouseButton1Click:Connect(function()
			Dropdown:Set(optionValue)
			ListFrame.Visible = false
		end))
	end

	table.insert(self.Window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		ListFrame.Visible = not ListFrame.Visible
	end))

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

-- ============================================================
-- 	KEYBIND
-- ============================================================
function SugarUI:CreateKeybind(config)
	config = config or {}
	local callback = config.Callback or function() end
	local currentKey = config.Default or Enum.KeyCode.RightShift
	local listening = false

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(16), stroke(Theme.Stroke, 1), pad(0, 0, 16, 0, 16) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Tecla",
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -110, 1, 0),
		Parent = Row,
	})

	local KeyButton = new("TextButton", {
		Text = currentKey.Name,
		Font = Theme.FontSemibold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.PanelAlt,
		Size = UDim2.new(0, 90, 0, 28),
		Position = UDim2.new(1, -90, 0.5, -14),
		Parent = Row,
	}, { corner(8), stroke(Theme.Stroke, 1) })

	local Keybind = setmetatable({ Value = currentKey, Callback = callback, _thread = nil }, SugarUI)

	-- :Set(KeyCode) reasigna la tecla programáticamente (ej: cargar un
	-- perfil de teclas guardado).
	function Keybind:Set(keyCode)
		self.Value = keyCode
		KeyButton.Text = keyCode.Name
		SugarUI.FlagValues[config.Flag] = keyCode
	end

	function Keybind:Stop()
		stopThread(self)
	end

	table.insert(self.Window._connections, KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
	end))

	table.insert(self.Window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			Keybind:Set(input.KeyCode)
			return
		end
		if not listening and not gameProcessed and input.KeyCode == Keybind.Value then
			-- La tecla asignada se presionó: dispara la lógica externa
			-- (ej: activar/desactivar un Auto-M1) sin congelar nada, sin
			-- importar de qué juego sea esa lógica.
			Keybind._thread = safeCall(Keybind.Callback, Keybind.Value)
		end
	end))

	registerFlag(config.Flag, Keybind, currentKey)
	return Keybind
end

return SugarUI
