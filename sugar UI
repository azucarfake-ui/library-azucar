-- ------------------------------------------------------------
-- 	Métodos de ventana (propiedades estándar de una librería UI)
-- ------------------------------------------------------------

-- Muestra la ventana (por si estaba oculta con :Hide())
function PanelUI:Show()
	self.Root.Visible = true
end

-- Oculta la ventana sin destruirla (equivalente a "minimizar")
function PanelUI:Hide()
	self.Root.Visible = false
end

-- Alterna entre mostrar/ocultar
function PanelUI:Toggle()
	self.Root.Visible = not self.Root.Visible
end

-- Destruye la ventana y limpia sus referencias
function PanelUI:Destroy()
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
	for i, w in ipairs(PanelUI.Windows) do
		if w == self then
			table.remove(PanelUI.Windows, i)
			break
		end
	end
end

-- ============================================================
-- 	SECCIONES DEL SIDEBAR (GENERAL / ACCIONES / etc.)
-- ============================================================
function PanelUI:_getSection(name)
	if self._sections[name] then
		return self._sections[name]
	end

	new("TextLabel", {
		Text = name,
		Font = Theme.FontSemibold,
		TextSize = 11,
		TextColor3 = Theme.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = #self._sections * 1000,
		Parent = self.SidebarList,
	})

	self._sections[name] = true
	return true
end

-- Línea divisoria dentro del sidebar (por ejemplo entre "Combate" y "Customs")
function PanelUI:CreateDivider()
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		LayoutOrder = 900 + (#self._sections * 1000),
		Parent = self.SidebarList,
	})
end

-- ============================================================
-- 	CREATE TAB
-- ============================================================
function PanelUI:CreateTab(config)
	config = config or {}
	self:_getSection(config.Section or "GENERAL")

	local isFirst = #self._tabs == 0

	local TabButton = new("TextButton", {
		Name = config.Name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = isFirst and Theme.Accent or Theme.Sidebar,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = self.SidebarList,
	}, { corner(9) })

	new("TextLabel", {
		Text = config.Icon or "•",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundColor3 = isFirst and Color3.fromRGB(255,255,255) or Theme.PanelAlt,
		BackgroundTransparency = isFirst and 0.85 or 0,
		Size = UDim2.new(0, 26, 0, 26),
		Position = UDim2.new(0, 9, 0.5, -13),
		Parent = TabButton,
	}, { corner(7) })

	new("TextLabel", {
		Text = config.Name or "Tab",
		Font = Theme.FontSemibold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -55, 1, 0),
		Position = UDim2.new(0, 45, 0, 0),
		Parent = TabButton,
	})

	if not isFirst then
		hoverTint(TabButton, Theme.Sidebar, Theme.PanelAlt)
	end

	-- Página de contenido asociada a la pestaña
	local Page = new("Frame", {
		Name = config.Name .. "Page",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = isFirst,
		LayoutOrder = 1,
		Parent = self.ContentScroll,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 18), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local HeaderTitle = new("TextLabel", {
		Text = config.Name,
		Font = Theme.FontBold,
		TextSize = 26,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 0,
		Parent = Page,
	})

	local HeaderSub = new("TextLabel", {
		Text = config.Description or "",
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 1,
		Visible = config.Description ~= nil,
		Parent = Page,
	})

	local Tab = setmetatable({
		Window = self,
		Button = TabButton,
		Page = Page,
		_rowCount = 2,
	}, PanelUI)

	TabButton.MouseButton1Click:Connect(function()
		for _, t in ipairs(self._tabs) do
			t.Page.Visible = false
			t.Button.BackgroundColor3 = Theme.Sidebar
		end
		Page.Visible = true
		TabButton.BackgroundColor3 = Theme.Accent
		if Tab.OnSelect then Tab.OnSelect() end
	end)

	table.insert(self._tabs, Tab)
	return Tab
end

