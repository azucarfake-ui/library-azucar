function SugarUI:CreateQuickAccess(config)
	config = config or {}
	local callback = config.Callback or function() end

	local Card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 84),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(18), stroke(Theme.Stroke, 1), pad(16) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Icon or "•",
		Font = Theme.FontBold,
		TextSize = 15,
		TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.PanelAlt,
		Size = UDim2.new(0, 34, 0, 34),
		Parent = Card,
	}, { corner(17) })

	new("TextLabel", {
		Text = config.Title or "Acceso",
		Font = Theme.FontSemibold,
		TextSize = 16,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 0, 20),
		Position = UDim2.new(0, 50, 0, 6),
		Parent = Card,
	})

	local ClickOverlay = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = Card,
	})

	local QuickAccess = setmetatable({ Card = Card, Callback = callback, _thread = nil }, SugarUI)

	-- :Set() dispara la lógica conectada como si se hubiera hecho click.
	-- Cualquier lógica del comprador (de cualquier juego) corre en su
	-- propio hilo, protegida con pcall.
	function QuickAccess:Set(...)
		self._thread = safeCall(self.Callback, ...)
	end

	-- Corta el hilo activo del callback, sin importar qué lógica tenga.
	function QuickAccess:Stop()
		stopThread(self)
	end

	table.insert(self.Window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		QuickAccess:Set()
	end))
	hoverTint(Card, Theme.Panel, Theme.PanelAlt)

	registerFlag(config.Flag, QuickAccess, nil)
	return QuickAccess
end

