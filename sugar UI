function SugarUI:CreateDropdown(config)
	config = config or {}
	local callback = config.Callback or function() end
	local options = config.Options or {}
	local selected = config.Default or options[1]

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
