--[[
	SugarUI
	--------
	Librería de UI en Luau para usar dentro de tu propio juego en Roblox
	Studio (paneles de administración, menús de configuración, HUDs, etc.)

	Arquitectura:
	- OOP con setmetatable/__index en cada nivel: SugarUI -> Window -> Tab -> Componentes.
	- Cada componente interactivo (Button, Toggle, Slider, Dropdown, Keybind)
	  ejecuta su callback con `task.spawn(function() pcall(Callback, ...) end)`,
	  así una lógica pesada o un `while true do ... task.wait() end` conectado
	  por el usuario corre en su propio hilo y NUNCA congela la interfaz.
	- Todos los componentes devuelven un "controlador" con `:Set(value)` para
	  actualizar la UI y disparar el callback de forma programática (por
	  ejemplo, para cargar una configuración guardada al abrir el panel).
	- Si el componente define `config.Flag`, su valor se guarda automáticamente
	  en `SugarUI.Flags[config.Flag]`, para poder leer el estado de todo el
	  panel desde un solo lugar.
	- El ScreenGui se parentea a `PlayerGui` (contenedor estándar dentro de
	  Roblox Studio / tu propio juego).

	Uso básico:

		local SugarUI = require(script.SugarUI)

		local Window = SugarUI:CreateWindow({ Title = "Panel del juego" })
		local Tab = Window:CreateTab({ Name = "General" })

		local speedSlider = Tab:CreateSlider({
			Text = "Velocidad de caminata",
			Min = 16, Max = 100, Default = 16,
			Flag = "WalkSpeed",
			Callback = function(value)
				-- tu lógica del juego aquí
			end,
		})

		-- Actualizar desde código (ej. al cargar config guardada):
		speedSlider:Set(32)

		-- Cerrar el panel y limpiar todas las conexiones:
		Window:Destroy()
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local SugarUI = {}
SugarUI.__index = SugarUI

SugarUI.Version = "1.0.0"
SugarUI.Flags = {}     -- SugarUI.Flags[flagName] = valor actual del componente
SugarUI.Windows = {}

-- ============================================================
-- 	TEMA
-- ============================================================
local Theme = {
	Background   = Color3.fromRGB(24, 24, 27),
	Panel        = Color3.fromRGB(32, 32, 36),
	PanelAlt     = Color3.fromRGB(42, 42, 47),
	Accent       = Color3.fromRGB(88, 101, 242),
	AccentDim    = Color3.fromRGB(64, 74, 180),
	Text         = Color3.fromRGB(235, 235, 240),
	TextDim      = Color3.fromRGB(165, 165, 175),
	Stroke       = Color3.fromRGB(55, 55, 62),
	Font         = Enum.Font.GothamMedium,
	FontBold     = Enum.Font.GothamBold,
	FontSemibold = Enum.Font.GothamSemibold,
}
SugarUI.Theme = Theme

-- ============================================================
-- 	HELPERS
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Stroke, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function hoverTint(obj, base, hover)
	obj.MouseEnter:Connect(function()
		TweenService:Create(obj, TweenInfo.new(0.12), { BackgroundColor3 = hover }):Play()
	end)
	obj.MouseLeave:Connect(function()
		TweenService:Create(obj, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
end

-- Ejecución asíncrona y segura de callbacks: corre en su propio hilo
-- (task.spawn) y protegido con pcall, así un error o un bucle largo dentro
-- del callback del usuario nunca congela ni rompe la interfaz.
local function safeCall(fn, ...)
	local args = { ... }
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args))
		if not ok then
			warn("[SugarUI] Error en callback: " .. tostring(err))
		end
	end)
end

-- Registra el valor de un componente en la tabla global de Flags, si tiene Flag.
local function setFlag(flag, value)
	if flag then
		SugarUI.Flags[flag] = value
	end
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function SugarUI:CreateWindow(config)
	config = config or {}

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	local playerGui = player:WaitForChild("PlayerGui")

	local ScreenGui = new("ScreenGui", {
		Name = config.Title or "SugarUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	local Root = new("Frame", {
		Size = config.Size or UDim2.new(0, 560, 0, 380),
		Position = config.Position or UDim2.new(0.5, -280, 0.5, -190),
		BackgroundColor3 = Theme.Background,
		ClipsDescendants = true,
		Parent = ScreenGui,
	}, { corner(14), stroke(Theme.Stroke, 1) })

	local TopBar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = Theme.Panel,
		Parent = Root,
	}, { corner(14) })

	new("TextLabel", {
		Text = config.Title or "SugarUI",
		Font = Theme.FontBold,
		TextSize = 15,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.new(0, 16, 0, 0),
		Parent = TopBar,
	})

	local TabBar = new("Frame", {
		Name = "TabBar",
		Size = UDim2.new(0, 140, 1, -54),
		Position = UDim2.new(0, 8, 0, 50),
		BackgroundColor3 = Theme.Panel,
		Parent = Root,
	}, { corner(10) })

	local TabList = new("ScrollingFrame", {
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.new(0, 4, 0, 4),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = TabBar,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local PageHolder = new("Frame", {
		Name = "PageHolder",
		Size = UDim2.new(1, -164, 1, -54),
		Position = UDim2.new(0, 156, 0, 50),
		BackgroundColor3 = Theme.Panel,
		Parent = Root,
	}, { corner(10) })

	local Window = setmetatable({
		ScreenGui = ScreenGui,
		Root = Root,
		TabList = TabList,
		PageHolder = PageHolder,
		_tabs = {},
		_connections = {},   -- todas las conexiones de eventos de esta ventana
	}, { __index = SugarUI })

	table.insert(SugarUI.Windows, Window)
	return Window
end

-- Desconecta todas las conexiones registradas por la ventana y sus
-- componentes, y destruye la interfaz. Úsalo al cerrar el panel para
-- evitar fugas de memoria.
function SugarUI.Window_Destroy(self)
	for _, conn in ipairs(self._connections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(self._connections)
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
	for i, w in ipairs(SugarUI.Windows) do
		if w == self then
			table.remove(SugarUI.Windows, i)
			break
		end
	end
end

-- ============================================================
-- 	CREATE TAB
-- ============================================================
function SugarUI.Window_CreateTab(self, config)
	config = config or {}
	local isFirst = #self._tabs == 0

	local TabButton = new("TextButton", {
		Text = config.Name or "Tab",
		Font = Theme.FontSemibold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = isFirst and Theme.Accent or Theme.PanelAlt,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = self.TabList,
	}, { corner(8) })

	local Page = new("ScrollingFrame", {
		Size = UDim2.new(1, -16, 1, -16),
		Position = UDim2.new(0, 8, 0, 8),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = isFirst,
		Parent = self.PageHolder,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Tab = setmetatable({
		Window = self,
		Button = TabButton,
		Page = Page,
		_rowCount = 0,
	}, { __index = SugarUI })

	local conn = TabButton.MouseButton1Click:Connect(function()
		for _, t in ipairs(self._tabs) do
			t.Page.Visible = false
			t.Button.BackgroundColor3 = Theme.PanelAlt
		end
		Page.Visible = true
		TabButton.BackgroundColor3 = Theme.Accent
	end)
	table.insert(self._connections, conn)

	if not isFirst then
		hoverTint(TabButton, Theme.PanelAlt, Theme.Accent)
	end

	table.insert(self._tabs, Tab)
	return Tab
end

-- ============================================================
-- 	BUTTON
-- ============================================================
function SugarUI.Tab_CreateButton(self, config)
	config = config or {}
	local Callback = config.Callback or function() end

	local Btn = new("TextButton", {
		Text = config.Text or "Botón",
		Font = Theme.FontSemibold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(8) })
	self._rowCount += 1

	hoverTint(Btn, Theme.Accent, Theme.AccentDim)

	local conn = Btn.MouseButton1Click:Connect(function()
		safeCall(Callback)
	end)
	table.insert(self.Window._connections, conn)

	local Controller = {
		Instance = Btn,
		-- :Set() en un botón simplemente vuelve a disparar su acción,
		-- útil para invocarlo programáticamente (ej. desde un keybind).
		Set = function(_self)
			safeCall(Callback)
		end,
	}
	return Controller
end

-- ============================================================
-- 	TOGGLE
-- ============================================================
function SugarUI.Tab_CreateToggle(self, config)
	config = config or {}
	local Callback = config.Callback or function() end
	local state = config.Default or false
	setFlag(config.Flag, state)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = Theme.PanelAlt,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(8), pad(0, 0, 12, 0, 12) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Opción",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 1, 0),
		Parent = Row,
	})

	local Track = new("Frame", {
		Size = UDim2.new(0, 38, 0, 20),
		Position = UDim2.new(1, -38, 0.5, -10),
		BackgroundColor3 = state and Theme.Accent or Theme.Panel,
		Parent = Row,
	}, { corner(10), stroke(Theme.Stroke, 1) })

	local Knob = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
		BackgroundColor3 = Theme.Text,
		Parent = Track,
	}, { corner(7) })

	local Overlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local Controller

	local function apply(newState, fireCallback)
		state = newState
		setFlag(config.Flag, state)
		TweenService:Create(Track, TweenInfo.new(0.15), { BackgroundColor3 = state and Theme.Accent or Theme.Panel }):Play()
		TweenService:Create(Knob, TweenInfo.new(0.15), { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }):Play()
		if fireCallback then
			safeCall(Callback, state)
		end
	end

	local conn = Overlay.MouseButton1Click:Connect(function()
		apply(not state, true)
	end)
	table.insert(self.Window._connections, conn)

	Controller = {
		Track = Track,
		Knob = Knob,
		-- :Set(true/false) actualiza la interfaz Y dispara el callback,
		-- para poder controlar el toggle desde código externo.
		Set = function(_self, value)
			apply(value, true)
		end,
	}
	return Controller
end

-- ============================================================
-- 	SLIDER
-- ============================================================
function SugarUI.Tab_CreateSlider(self, config)
	config = config or {}
	local Callback = config.Callback or function() end
	local min = config.Min or 0
	local max = config.Max or 100
	local value = math.clamp(config.Default or min, min, max)
	setFlag(config.Flag, value)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = Theme.PanelAlt,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(8), pad(0, 8, 12, 8, 12) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Valor",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -46, 0, 16),
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = tostring(value),
		Font = Theme.FontSemibold,
		TextSize = 12,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 46, 0, 16),
		Position = UDim2.new(1, -46, 0, 0),
		Parent = Row,
	})

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 0, 26),
		BackgroundColor3 = Theme.Panel,
		Parent = Row,
	}, { corner(3) })

	local function ratio(v)
		return (v - min) / math.max(max - min, 1e-6)
	end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		Parent = Track,
	}, { corner(3) })

	local Knob = new("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(ratio(value), -6, 0.5, -6),
		BackgroundColor3 = Theme.Text,
		Parent = Track,
	}, { corner(6) })

	local Controller
	local dragging = false

	local function apply(newValue, fireCallback)
		newValue = math.clamp(math.floor(newValue + 0.5), min, max)
		value = newValue
		setFlag(config.Flag, value)
		local r = ratio(value)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, -6, 0.5, -6)
		ValueLabel.Text = tostring(value)
		if fireCallback then
			safeCall(Callback, value)
		end
	end

	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		apply(min + relative * (max - min), true)
	end

	local conn1 = Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	local conn2 = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	local conn3 = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	table.insert(self.Window._connections, conn1)
	table.insert(self.Window._connections, conn2)
	table.insert(self.Window._connections, conn3)

	Controller = {
		Track = Track,
		Fill = Fill,
		Knob = Knob,
		Value = value,
		-- :Set(numero) actualiza la barra Y dispara el callback.
		Set = function(_self, newValue)
			apply(newValue, true)
			_self.Value = value
		end,
	}
	return Controller
end

-- ============================================================
-- 	DROPDOWN
-- ============================================================
function SugarUI.Tab_CreateDropdown(self, config)
	config = config or {}
	local Callback = config.Callback or function() end
	local options = config.Options or {}
	local selected = config.Default or options[1]
	setFlag(config.Flag, selected)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.PanelAlt,
		LayoutOrder = self._rowCount,
		ClipsDescendants = false,
		ZIndex = 2,
		Parent = self.Page,
	}, { corner(8) })
	self._rowCount += 1

	local Header = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 36),
		ZIndex = 2,
		Parent = Row,
	})

	new("TextLabel", {
		Text = config.Text or "Opciones",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, -12, 1, 0),
		Position = UDim2.new(0, 12, 0, 0),
		ZIndex = 2,
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = tostring(selected or ""),
		Font = Theme.FontSemibold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, -12, 1, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		ZIndex = 2,
		Parent = Row,
	})

	local ListFrame = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.new(0, 0, 1, 4),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		ZIndex = 5,
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = Row,
	}, {
		corner(8), stroke(Theme.Stroke, 1),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(4),
	})

	local Controller
	local open = false

	local function selectOption(opt, fireCallback)
		selected = opt
		setFlag(config.Flag, selected)
		SelectedLabel.Text = tostring(opt)
		if fireCallback then
			safeCall(Callback, opt)
		end
	end

	for _, opt in ipairs(options) do
		local OptBtn = new("TextButton", {
			Text = tostring(opt),
			Font = Theme.Font,
			TextSize = 13,
			TextColor3 = Theme.Text,
			AutoButtonColor = false,
			BackgroundColor3 = Theme.PanelAlt,
			Size = UDim2.new(1, 0, 0, 28),
			ZIndex = 6,
			Parent = ListFrame,
		}, { corner(6) })

		hoverTint(OptBtn, Theme.PanelAlt, Theme.Accent)

		local conn = OptBtn.MouseButton1Click:Connect(function()
			selectOption(opt, true)
			open = false
			ListFrame.Visible = false
		end)
		table.insert(self.Window._connections, conn)
	end

	local headerConn = Header.MouseButton1Click:Connect(function()
		open = not open
		ListFrame.Visible = open
	end)
	table.insert(self.Window._connections, headerConn)

	Controller = {
		Row = Row,
		-- :Set(opcion) actualiza el texto seleccionado Y dispara el callback.
		Set = function(_self, opt)
			selectOption(opt, true)
		end,
	}
	return Controller
end

-- ============================================================
-- 	KEYBIND
-- ============================================================
function SugarUI.Tab_CreateKeybind(self, config)
	config = config or {}
	local Callback = config.Callback or function() end
	local currentKey = config.Default or Enum.KeyCode.Unknown
	setFlag(config.Flag, currentKey)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.PanelAlt,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(8), pad(0, 0, 12, 0, 12) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Tecla",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -90, 1, 0),
		Parent = Row,
	})

	local KeyButton = new("TextButton", {
		Text = currentKey.Name,
		Font = Theme.FontSemibold,
		TextSize = 12,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(0, 74, 0, 26),
		Position = UDim2.new(1, -74, 0.5, -13),
		Parent = Row,
	}, { corner(6), stroke(Theme.Stroke, 1) })

	local Controller
	local listening = false

	local function apply(newKey, fireCallback)
		currentKey = newKey
		setFlag(config.Flag, currentKey)
		KeyButton.Text = currentKey.Name
		if fireCallback then
			safeCall(Callback, currentKey)
		end
	end

	local btnConn = KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
	end)
	table.insert(self.Window._connections, btnConn)

	-- Captura la siguiente tecla presionada para reasignar el keybind.
	local inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			apply(input.KeyCode, true)
		elseif not listening and not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
			-- Dispara el callback cada vez que se presiona la tecla asignada,
			-- ideal para activar/desactivar una habilidad o menú.
			if input.KeyCode == currentKey then
				safeCall(Callback, currentKey)
			end
		end
	end)
	table.insert(self.Window._connections, inputConn)

	Controller = {
		Instance = KeyButton,
		-- :Set(Enum.KeyCode.X) reasigna la tecla programáticamente.
		Set = function(_self, newKey)
			apply(newKey, true)
		end,
	}
	return Controller
end

-- Enlazar los métodos "Window_" y "Tab_" a sus respectivas metatablas
-- (separados así para mantener el archivo organizado por componente).
local WindowMethods = { CreateTab = SugarUI.Window_CreateTab, Destroy = SugarUI.Window_Destroy }
local TabMethods = {
	CreateButton = SugarUI.Tab_CreateButton,
	CreateToggle = SugarUI.Tab_CreateToggle,
	CreateSlider = SugarUI.Tab_CreateSlider,
