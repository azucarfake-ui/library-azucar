--[[
	PanelUI
	--------
	Librería de UI (solo interfaz, SIN lógica interna) inspirada en el diseño
	mostrado: tema oscuro, acentos rojos, sidebar con secciones, tarjetas de
	estadísticas y accesos rápidos.

	Uso básico:

		local PanelUI = require(script.PanelUI)

		local Window = PanelUI:CreateWindow({
			Title       = "Top 1 Col",
			Badge       = "ADMIN",
			ServerName  = "Servidor en línea",
			ServerOn    = true,
		})

		local Principal = Window:CreateTab({ Name = "Principal", Icon = "P", Section = "GENERAL" })
		local Teleport   = Window:CreateTab({ Name = "Teleport",  Icon = "T", Section = "ACCIONES" })
		local Combate    = Window:CreateTab({ Name = "Combate",   Icon = "C", Section = "ACCIONES" })

		Principal:CreateStat({ Value = "24", Label = "jugadores en línea" })
		Principal:CreateStat({ Value = "3",  Label = "reportes sin revisar" })
		Principal:CreateStat({ Value = "98%",Label = "estabilidad de servidor" })

		local quick = Principal:CreateQuickAccess({ Icon = "T", Title = "Teleport" })
		quick.OnClick = function() end -- <- aquí conectas tu propia lógica

	Todo lo que ves aquí es SOLO interfaz: la construcción visual (Instance.new),
	el layout y las animaciones básicas de hover/click. No incluye ningún
	comportamiento de juego (teletransportar, combate, etc.) — eso lo agregas
	tú, conectándolo a los eventos `.OnClick`, `.OnToggle`, `.OnChange`,
	`.OnSelect`, etc. que expone cada elemento.

	CÓMO FUNCIONA LA EJECUCIÓN DE TU LÓGICA:
	Cada elemento interactivo (botón, toggle, slider, tab, acceso rápido)
	guarda tu función en una propiedad (Elemento.OnClick = function() ... end)
	y, cuando ocurre el evento real (click, arrastre, etc.), la librería la
	llama a través de `safeCall`. `safeCall` usa `pcall` internamente, así que:
	  - Tu función puede contener CUALQUIER lógica (teleport, combate, kick,
	    cambiar stats, etc.) — la librería no la restringe de ninguna forma.
	  - Si tu función lanza un error, ese error se reporta en el output con
	    `warn(...)` pero NO rompe ni congela el resto de la interfaz.
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local PanelUI = {}
PanelUI.__index = PanelUI

-- ============================================================
-- 	PROPIEDADES DE LIBRERÍA
-- ============================================================
PanelUI.Version   = "1.1.0"
PanelUI.Windows   = {}   -- todas las ventanas creadas, por si necesitas iterarlas
PanelUI.Flags     = {}   -- opcional: aquí puedes ir guardando el estado de toggles/etc.
PanelUI.Theme     = nil  -- se asigna abajo, expuesto para poder leer/cambiar colores

-- Encuentra dónde parentear el ScreenGui: primero intenta CoreGui (protegido,
-- típico en librerías con executor), si no existe cae a PlayerGui (Roblox Studio /
-- juego normal).
local function getGuiParent()
	local ok, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)

	if ok and coreGui then
		-- gethui()/protect_gui existen en la mayoría de executors; si no existen,
		-- simplemente usamos CoreGui directo o hacemos fallback a PlayerGui.
		local getHui = rawget(_G, "gethui")
		if typeof(getHui) == "function" then
			local success, hui = pcall(getHui)
			if success and hui then
				return hui
			end
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	local playerGui = player:WaitForChild("PlayerGui")
	return playerGui
end

-- ============================================================
-- 	PALETA / TEMA
-- ============================================================
local Theme = {
	Background      = Color3.fromRGB(46, 12, 16),    -- fondo rojo oscuro (semi-transparente)
	Sidebar         = Color3.fromRGB(42, 11, 15),
	Panel           = Color3.fromRGB(58, 16, 20),
	PanelAlt        = Color3.fromRGB(70, 20, 25),
	Accent          = Color3.fromRGB(214, 38, 51),   -- rojo principal (botones)
	AccentDim       = Color3.fromRGB(150, 26, 36),
	Text            = Color3.fromRGB(240, 240, 242),
	TextDim         = Color3.fromRGB(210, 175, 178),
	TextFaint       = Color3.fromRGB(170, 130, 133),
	Online          = Color3.fromRGB(63, 201, 141),
	Stroke          = Color3.fromRGB(90, 30, 35),
	Font            = Enum.Font.GothamMedium,
	FontBold        = Enum.Font.GothamBold,
	FontSemibold    = Enum.Font.GothamSemibold,

	-- Transparencias (0 = opaco, 1 = invisible)
	BackgroundTransparency = 0.35,
	PanelTransparency       = 0.25,
}

PanelUI.Theme = Theme -- expuesto como propiedad pública de la librería

-- ============================================================
-- 	HELPERS
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function stroke(color, thickness)
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
	})
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function hoverTint(guiObject, baseColor, hoverColor)
	guiObject.MouseEnter:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor }):Play()
	end)
	guiObject.MouseLeave:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = baseColor }):Play()
	end)
end

-- Pequeño "press" visual: encoge un poco el botón al hacer click, para dar
-- sensación de feedback físico (solo estético).
local function pressFeedback(guiObject)
	guiObject.MouseButton1Down:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.06), { Size = guiObject.Size - UDim2.new(0, 4, 0, 2) }):Play()
	end)
	local function restore()
		TweenService:Create(guiObject, TweenInfo.new(0.08), { Size = guiObject.Size + UDim2.new(0, 4, 0, 2) }):Play()
	end
	guiObject.MouseButton1Up:Connect(restore)
	guiObject.MouseLeave:Connect(restore)
end

-- Degradado sutil rojo→rojo oscuro, para darle profundidad a botones y acentos
local function accentGradient(rotation)
	return new("UIGradient", {
		Color = ColorSequence.new(Theme.Accent, Theme.AccentDim),
		Rotation = rotation or 90,
	})
end

-- Ejecuta cualquier lógica que el usuario haya conectado (.OnClick, .OnToggle,
-- .OnChange, .OnSelect, etc.) de forma segura: si esa lógica lanza un error,
-- no rompe la interfaz — solo se reporta en el output, y la UI sigue
-- funcionando normal. Esta es la función que le permite a la librería
-- ejecutar CUALQUIER lógica externa que el usuario conecte.
local function safeCall(fn, ...)
	if typeof(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[PanelUI] Error en callback conectado por el usuario: " .. tostring(err))
	end
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function PanelUI:CreateWindow(config)
	config = config or {}

	local ScreenGui = new("ScreenGui", {
		Name = config.Title or "PanelUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})

	-- Blindaje opcional contra detección (solo si el entorno lo soporta; en
	-- Roblox Studio / juego normal simplemente no hace nada).
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then
		pcall(protectGui, ScreenGui)
	end

	ScreenGui.Parent = getGuiParent()

	-- Contenedor raíz
	local Root = new("Frame", {
		Name = "Root",
		Size = config.Size or UDim2.new(0, 640, 0, 440),
		Position = config.Position or UDim2.new(0.5, -320, 0.5, -220),
		BackgroundColor3 = config.BackgroundColor or Theme.Background,
		BackgroundTransparency = config.BackgroundTransparency or Theme.BackgroundTransparency,
		ClipsDescendants = true,
		Parent = ScreenGui,
	}, { corner(22), stroke(Theme.Stroke, 1) })

	-- Constantes de layout: separa TopBar / Sidebar / Content como tarjetas
	-- flotantes con huecos entre ellas, para que TODAS tengan esquinas
	-- redondeadas visibles (no solo el borde exterior).
	local MARGIN = 12
	local GAP = 10
	local TOPBAR_H = 54
	local SIDEBAR_W = 190
	local ROW_Y = MARGIN + TOPBAR_H + GAP

	-- ---------------- Barra superior ----------------
	local TopBar = new("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, -MARGIN * 2, 0, TOPBAR_H),
		Position = UDim2.new(0, MARGIN, 0, MARGIN),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	local Badge1 = new("TextLabel", {
		Text = "1",
		Font = Theme.FontBold,
		TextSize = 16,
		TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 32, 0, 32),
		Position = UDim2.new(0, 16, 0.5, -16),
		Parent = TopBar,
	}, { corner(16), accentGradient() })

	local TitleLabel = new("TextLabel", {
		Text = config.Title or "Panel",
		Font = Theme.FontBold,
		TextSize = 17,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 160, 0, 20),
		Position = UDim2.new(0, 60, 0.5, -10),
		Parent = TopBar,
	})

	local AdminBadge
	if config.Badge then
		AdminBadge = new("TextLabel", {
			Text = config.Badge,
			Font = Theme.FontBold,
			TextSize = 11,
			TextColor3 = Theme.Text,
			BackgroundColor3 = Theme.Accent,
			Size = UDim2.new(0, 54, 0, 22),
			Position = UDim2.new(0, 220, 0.5, -11),
			Parent = TopBar,
		}, { corner(11), accentGradient() })
	end

	local ServerPill = new("Frame", {
		Size = UDim2.new(0, 190, 0, 32),
		Position = UDim2.new(0, 300, 0.5, -16),
		BackgroundColor3 = Theme.PanelAlt,
		Parent = TopBar,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	new("Frame", {
		Size = UDim2.new(0, 8, 0, 8),
		Position = UDim2.new(0, 14, 0.5, -4),
		BackgroundColor3 = config.ServerOn ~= false and Theme.Online or Theme.TextFaint,
		Parent = ServerPill,
	}, { corner(4) })

	new("TextLabel", {
		Text = config.ServerName or "Servidor en línea",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -32, 1, 0),
		Position = UDim2.new(0, 28, 0, 0),
		Parent = ServerPill,
	})

	-- Botones de control (minimizar / cerrar) — rojos, solo visuales
	local MinimizeBtn = new("TextButton", {
		Text = "—",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 32, 0, 32),
		Position = UDim2.new(1, -80, 0.5, -16),
		Parent = TopBar,
	}, { corner(16), accentGradient() })

	local CloseBtn = new("TextButton", {
		Text = "✕",
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Accent,
		Size = UDim2.new(0, 32, 0, 32),
		Position = UDim2.new(1, -40, 0.5, -16),
		Parent = TopBar,
	}, { corner(16), accentGradient() })

	hoverTint(MinimizeBtn, Theme.Accent, Theme.AccentDim)
	hoverTint(CloseBtn, Theme.Accent, Theme.AccentDim)
	pressFeedback(MinimizeBtn)
	pressFeedback(CloseBtn)

	-- ---------------- Sidebar ----------------
	local Sidebar = new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, SIDEBAR_W, 1, -(ROW_Y + MARGIN)),
		Position = UDim2.new(0, MARGIN, 0, ROW_Y),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	local SearchBox = new("TextBox", {
		PlaceholderText = "Buscar pestaña...",
		Text = "",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		BackgroundColor3 = Theme.PanelAlt,
		Size = UDim2.new(1, -32, 0, 36),
		Position = UDim2.new(0, 16, 0, 16),
		Parent = Sidebar,
	}, { corner(18), pad(0, 0, 0, 0, 12), stroke(Theme.Stroke, 1) })

	local SidebarList = new("ScrollingFrame", {
		Name = "SidebarList",
		Size = UDim2.new(1, 0, 1, -142),
		Position = UDim2.new(0, 0, 0, 66),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Sidebar,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 4, 16, 16, 16),
	})

	-- ---------------- Tarjeta de perfil (parte inferior del sidebar) ----------------
	local ProfileDivider = new("Frame", {
		Size = UDim2.new(1, -32, 0, 1),
		Position = UDim2.new(0, 16, 1, -78),
		BackgroundColor3 = Theme.Stroke,
		Parent = Sidebar,
	})

	local ProfileRow = new("Frame", {
		Name = "ProfileRow",
		Size = UDim2.new(1, -32, 0, 46),
		Position = UDim2.new(0, 16, 1, -60),
		BackgroundTransparency = 1,
		Parent = Sidebar,
	})

	-- ---------------- Área de contenido ----------------
	local Content = new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -(MARGIN + SIDEBAR_W + GAP + MARGIN), 1, -(ROW_Y + MARGIN)),
		Position = UDim2.new(0, MARGIN + SIDEBAR_W + GAP, 0, ROW_Y),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })

	local ContentScroll = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Content,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 20), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 20, 20, 20, 20),
	})

	-- ---------------- Burbuja flotante (aparece al minimizar / cerrar) ----------------
	local Bubble = new("TextButton", {
		Name = "Bubble",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(0, 50, 0, 50),
		Position = UDim2.new(1, -80, 1, -80),
		BackgroundColor3 = Theme.Accent,
		Visible = false,
		Parent = ScreenGui,
	}, { corner(25), stroke(Theme.Stroke, 1), accentGradient(135) })

	new("TextLabel", {
		Text = "🍬",
		Font = Theme.FontBold,
		TextSize = 22,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = Bubble,
	})

	hoverTint(Bubble, Theme.Accent, Theme.AccentDim)

	-- ============================================================
	local Window = setmetatable({
		ScreenGui = ScreenGui,
		Root = Root,
		Sidebar = Sidebar,
		SidebarList = SidebarList,
		ProfileRow = ProfileRow,
		Content = Content,
		ContentScroll = ContentScroll,
		Bubble = Bubble,
		_tabs = {},
		_sections = {},
	}, PanelUI)

	Bubble.MouseButton1Click:Connect(function()
		Window:Show()
	end)

	-- Arrastrar la burbuja también
	do
		local dragging = false
		local dragStart, startPos
		Bubble.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Bubble.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Bubble.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)
	end

	MinimizeBtn.MouseButton1Click:Connect(function()
		Window:Hide()
		safeCall(Window.OnMinimize)
	end)
	CloseBtn.MouseButton1Click:Connect(function()
		Window:Hide()
		safeCall(Window.OnClose)
	end)

	-- ---------------- Arrastrar la ventana (desde la barra superior) ----------------
	local dragConnections = {}
	do
		local dragging = false
		local dragStart, startPos

		table.insert(dragConnections, TopBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = Root.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end))

		table.insert(dragConnections, UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				Root.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
	end

	-- ---------------- Atajo de teclado para esconder/mostrar (por defecto: K) ----------------
	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	local toggleConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end)
	table.insert(dragConnections, toggleConnection)
	Window._connections = dragConnections

	table.insert(PanelUI.Windows, Window)
	return Window
end

-- ------------------------------------------------------------
-- 	Métodos de ventana (propiedades estándar de una librería UI)
-- ------------------------------------------------------------

-- Muestra la ventana (por si estaba oculta con :Hide())
function PanelUI:Show()
	self.Root.Visible = true
	if self.Bubble then
		self.Bubble.Visible = false
	end
end

-- Oculta la ventana y muestra la burbuja flotante para volver a abrirla
function PanelUI:Hide()
	self.Root.Visible = false
	if self.Bubble then
		self.Bubble.Visible = true
	end
end

-- Alterna entre mostrar/ocultar
function PanelUI:Toggle()
	if self.Root.Visible then
		self:Hide()
	else
		self:Show()
	end
end

-- Destruye la ventana y limpia sus referencias
function PanelUI:Destroy()
	if self._connections then
		for _, conn in ipairs(self._connections) do
			conn:Disconnect()
		end
	end
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
	for i, w in ipairs(PanelUI.Windows) do
		if w == self then
			table.remove(PanelUI.Windows, i)
			break
		end
	end
end

-- ============================================================
-- 	SECCIONES DEL SIDEBAR (GENERAL / ACCIONES / etc.)
-- ============================================================
function PanelUI:_getSection(name)
	if self._sections[name] then
		return self._sections[name]
	end

	new("TextLabel", {
		Text = name,
		Font = Theme.FontSemibold,
		TextSize = 11,
		TextColor3 = Theme.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = #self._sections * 1000,
		Parent = self.SidebarList,
	})

	self._sections[name] = true
	return true
end

-- Línea divisoria dentro del sidebar (por ejemplo entre "Combate" y "Customs")
function PanelUI:CreateDivider()
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		LayoutOrder = 900 + (#self._sections * 1000),
		Parent = self.SidebarList,
	})
end

-- ============================================================
-- 	CREATE TAB
-- ============================================================
function PanelUI:CreateTab(config)
	config = config or {}
	self:_getSection(config.Section or "GENERAL")

	local isFirst = #self._tabs == 0

	local tabChildren = { corner(22) }
	if isFirst then
		table.insert(tabChildren, accentGradient())
	end

	local TabButton = new("TextButton", {
		Name = config.Name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = isFirst and Theme.Accent or Theme.Sidebar,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = self.SidebarList,
	}, tabChildren)

	new("TextLabel", {
		Text = config.Icon or "•",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundColor3 = isFirst and Color3.fromRGB(255,255,255) or Theme.PanelAlt,
		BackgroundTransparency = isFirst and 0.85 or 0,
		Size = UDim2.new(0, 26, 0, 26),
		Position = UDim2.new(0, 9, 0.5, -13),
		Parent = TabButton,
	}, { corner(13) })

	new("TextLabel", {
		Text = config.Name or "Tab",
		Font = Theme.FontSemibold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -55, 1, 0),
		Position = UDim2.new(0, 45, 0, 0),
		Parent = TabButton,
	})

	if not isFirst then
		hoverTint(TabButton, Theme.Sidebar, Theme.PanelAlt)
	end

	-- Página de contenido asociada a la pestaña
	local Page = new("Frame", {
		Name = config.Name .. "Page",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = isFirst,
		LayoutOrder = 1,
