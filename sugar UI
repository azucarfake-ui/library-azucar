		Parent = Track,
	}, { corner(8) })

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Parent = Row })

	local Toggle = setmetatable({ Track = Track, Knob = Knob }, PanelUI)
	ClickOverlay.MouseButton1Click:Connect(function()
		state = not state
		TweenService:Create(Track, TweenInfo.new(0.15), { BackgroundColor3 = state and Theme.Accent or Theme.PanelAlt }):Play()
		TweenService:Create(Knob, TweenInfo.new(0.15), { Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) }):Play()
		safeCall(Toggle.OnToggle, state)
	end)

	return Toggle
end

-- Slider (barra deslizable) — al arrastrar ejecuta (de forma segura) la
-- lógica que el usuario conecte en .OnChange(value).
-- Ahora es más compacto: menos alto, barra más delgada y knob más pequeño.
-- config: Text, Min (default 0), Max (default 100), Default (valor inicial)
function PanelUI:CreateSlider(config)
	config = config or {}
	local min = config.Min or 0
	local max = config.Max or 100
	local value = math.clamp(config.Default or min, min, max)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(14), stroke(Theme.Stroke, 1), pad(0, 8, 14, 8, 14) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Valor",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -46, 0, 16),
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = tostring(value),
		Font = Theme.FontSemibold,
		TextSize = 12,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 46, 0, 16),
		Position = UDim2.new(1, -46, 0, 0),
		Parent = Row,
	})

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 0, 26),
		BackgroundColor3 = Theme.PanelAlt,
		Parent = Row,
	}, { corner(3) })

	local function ratio(v)
		return (v - min) / math.max(max - min, 1e-6)
	end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		Parent = Track,
	}, { corner(3) })

	local Knob = new("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(ratio(value), -6, 0.5, -6),
		BackgroundColor3 = Theme.Text,
		Parent = Track,
	}, { corner(6), stroke(Theme.Stroke, 1) })

	local Slider = setmetatable({ Track = Track, Fill = Fill, Knob = Knob, Value = value }, PanelUI)

	local dragging = false

	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		value = math.floor(min + relative * (max - min) + 0.5)
		Fill.Size = UDim2.new(relative, 0, 1, 0)
		Knob.Position = UDim2.new(relative, -6, 0.5, -6)
		ValueLabel.Text = tostring(value)
		Slider.Value = value
		safeCall(Slider.OnChange, value)
	end

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)

	return Slider
end

return PanelUI
